{
  "name": "TUUUT",
  "short_name": "TUUUT",
  "description": "Bladmuziek op je tablet: partituren per orkest, aantekenen, metronoom en stemapparaat. Werkt zonder internet.",
  "lang": "nl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0D0E10",
  "theme_color": "#0D0E10",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf", "application/zip", "application/x-zip-compressed", ".zip", "image/*"] }
      ]
    }
  }
}
